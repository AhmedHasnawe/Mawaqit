<Window x:Class="Mawaqit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Mawaqit.Controls"
        Title="مواقيت"
        Width="360" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        FlowDirection="RightToLeft">

    <Window.ContextMenu>
        <ContextMenu x:Name="RootMenu" FlowDirection="RightToLeft">
            <MenuItem x:Name="MenuNext"     Click="MenuNext_Click"/>
            <MenuItem x:Name="MenuPrev"     Click="MenuPrev_Click"/>
            <MenuItem x:Name="MenuAuto"     Click="MenuAuto_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuSettings" Click="MenuSettings_Click"/>
            <MenuItem x:Name="MenuToday"    Click="MenuToday_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuTop"      IsCheckable="True" Click="MenuTop_Click"/>
            <MenuItem x:Name="MenuStartup"  IsCheckable="True" Click="MenuStartup_Click"/>
            <MenuItem x:Name="MenuLock"     IsCheckable="True" Click="MenuLock_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuSizeRoot">
                <MenuItem x:Name="MenuSize1" Tag="130" Click="MenuSize_Click"/>
                <MenuItem x:Name="MenuSize2" Tag="180" Click="MenuSize_Click"/>
                <MenuItem x:Name="MenuSize3" Tag="260" Click="MenuSize_Click"/>
                <MenuItem x:Name="MenuSize4" Tag="360" Click="MenuSize_Click"/>
                <MenuItem x:Name="MenuSize5" Tag="520" Click="MenuSize_Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuLangRoot">
                <MenuItem x:Name="MenuLangAr" Header="العربية" IsCheckable="True" Click="MenuLangAr_Click"/>
                <MenuItem x:Name="MenuLangEn" Header="English" IsCheckable="True" Click="MenuLangEn_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="MenuAbout" Click="MenuAbout_Click"/>
            <MenuItem x:Name="MenuExit"  Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <ctl:ClockFace x:Name="Face" FlowDirection="LeftToRight"
                       MouseLeftButtonDown="Face_MouseLeftButtonDown"
                       MouseWheel="Face_MouseWheel"/>
    </Grid>
</Window>
