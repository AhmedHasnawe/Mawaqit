<Window x:Class="Mawaqit.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Mawaqit.Controls"
        Title="Mawaqit"
        Width="860" Height="620"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF4F4F6">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,3,4,0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="BorderBrush" Value="#FF888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4,2,4,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">

            <!-- ============ الموقع ============ -->
            <TabItem x:Name="TabLocation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Label x:Name="LblCity"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearch" Grid.Column="0"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock x:Name="LblSearch" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,4"/>
                        </Grid>
                        <ListBox x:Name="LstCities" Height="190"
                                 SelectionChanged="LstCities_SelectionChanged"
                                 DisplayMemberPath="Display"/>

                        <CheckBox x:Name="ChkManual"
                                  Checked="ChkManual_Changed" Unchecked="ChkManual_Changed"/>

                        <Grid x:Name="GridManual" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label x:Name="LblPlaceName" Grid.Row="0" Grid.Column="0"/>
                            <TextBox x:Name="TxtCityName" Grid.Row="1" Grid.Column="0"/>
                            <Label x:Name="LblElevation" Grid.Row="0" Grid.Column="2"/>
                            <TextBox x:Name="TxtElevation" Grid.Row="1" Grid.Column="2"/>

                            <Label x:Name="LblLat" Grid.Row="2" Grid.Column="0"/>
                            <TextBox x:Name="TxtLat" Grid.Row="3" Grid.Column="0"/>
                            <Label x:Name="LblLng" Grid.Row="2" Grid.Column="2"/>
                            <TextBox x:Name="TxtLng" Grid.Row="3" Grid.Column="2"/>
                        </Grid>

                        <Separator Margin="0,10,0,6"/>
                        <CheckBox x:Name="ChkSysTz"
                                  Checked="ChkSysTz_Changed" Unchecked="ChkSysTz_Changed"/>
                        <Label x:Name="LblFixedOffset"/>
                        <TextBox x:Name="TxtOffset" Width="120" HorizontalAlignment="Right" IsEnabled="False"/>
                        <TextBlock x:Name="TxtTzInfo" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ الحساب ============ -->
            <TabItem x:Name="TabCalc">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Label x:Name="LblMethod"/>
                        <ComboBox x:Name="CmbMethod" DisplayMemberPath="NameAr"
                                  SelectionChanged="Recalc_Changed"/>
                        <TextBlock x:Name="TxtMethodInfo" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,2,0,8"/>

                        <Label x:Name="LblPrayerSet"/>
                        <ComboBox x:Name="CmbPrayerSet" SelectionChanged="Recalc_Changed">
                            <ComboBoxItem x:Name="ItmSetFive"/>
                            <ComboBoxItem x:Name="ItmSetThree"/>
                        </ComboBox>
                        <TextBlock x:Name="LblSetNote" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,2,0,8"/>

                        <Label x:Name="LblAsr"/>
                        <ComboBox x:Name="CmbAsr" SelectionChanged="Recalc_Changed">
                            <ComboBoxItem x:Name="ItmAsrStd"/>
                            <ComboBoxItem x:Name="ItmAsrHanafi"/>
                        </ComboBox>

                        <Label x:Name="LblHighLat"/>
                        <ComboBox x:Name="CmbHighLat" SelectionChanged="Recalc_Changed">
                            <ComboBoxItem x:Name="ItmHl0"/>
                            <ComboBoxItem x:Name="ItmHl1"/>
                            <ComboBoxItem x:Name="ItmHl2"/>
                            <ComboBoxItem x:Name="ItmHl3"/>
                        </ComboBox>

                        <Separator Margin="0,12,0,6"/>
                        <Label x:Name="LblTune"/>
                        <Grid x:Name="GridTune">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        </Grid>

                        <Separator Margin="0,12,0,6"/>
                        <Label x:Name="LblTodayTimes"/>
                        <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White" Padding="8">
                            <TextBlock x:Name="TxtPreviewTimes" FontFamily="Consolas" FontSize="14"
                                       TextWrapping="Wrap" LineHeight="22"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ الألوان ============ -->
            <TabItem x:Name="TabColours">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Label x:Name="LblPreset"/>
                        <ComboBox x:Name="CmbTheme" SelectionChanged="CmbTheme_Changed"/>

                        <Separator Margin="0,10,0,6"/>
                        <Label x:Name="LblPrayerColours" FontWeight="Bold"/>
                        <UniformGrid x:Name="GridPrayerColors" Columns="5" Rows="1"/>

                        <Separator Margin="0,10,0,6"/>
                        <Label x:Name="LblClockColours" FontWeight="Bold"/>
                        <UniformGrid x:Name="GridFaceColors" Columns="5" Rows="4"/>

                        <TextBlock x:Name="LblColoursNote" Margin="0,10,0,0" Foreground="#FF555555" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ المظهر والسلوك ============ -->
            <TabItem x:Name="TabAppearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label x:Name="LblLanguage" Grid.Row="0" Grid.Column="0"/>
                            <ComboBox x:Name="CmbLanguage" Grid.Row="1" Grid.Column="0" SelectionChanged="CmbLanguage_Changed">
                                <ComboBoxItem Content="العربية"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>

                            <Label x:Name="LblNumerals" Grid.Row="0" Grid.Column="2"/>
                            <ComboBox x:Name="CmbNumerals" Grid.Row="1" Grid.Column="2" SelectionChanged="Preview_Changed">
                                <ComboBoxItem x:Name="ItmNum0"/>
                                <ComboBoxItem x:Name="ItmNum1"/>
                                <ComboBoxItem x:Name="ItmNum2"/>
                                <ComboBoxItem x:Name="ItmNum3"/>
                            </ComboBox>

                            <Label x:Name="LblFont" Grid.Row="2" Grid.Column="0"/>
                            <ComboBox x:Name="CmbFont" Grid.Row="3" Grid.Column="0" SelectionChanged="Preview_Changed"/>

                            <Label x:Name="LblHighlight" Grid.Row="2" Grid.Column="2"/>
                            <ComboBox x:Name="CmbHighlight" Grid.Row="3" Grid.Column="2" SelectionChanged="Preview_Changed">
                                <ComboBoxItem x:Name="ItmHi0"/>
                                <ComboBoxItem x:Name="ItmHi1"/>
                            </ComboBox>

                            <Label x:Name="LblSize" Grid.Row="4" Grid.Column="0"/>
                            <TextBox x:Name="TxtSize" Grid.Row="5" Grid.Column="0" TextChanged="Preview_Changed"/>
                        </Grid>

                        <Label x:Name="LblOpacity"/>
                        <Slider x:Name="SldOpacity" Minimum="0.25" Maximum="1.0" Value="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="Preview_Changed"/>

                        <Separator Margin="0,10,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="ChkPrayerHands" Click="Preview_Changed"/>
                                <CheckBox x:Name="ChkAutoReturn" Click="Preview_Changed"/>
                                <CheckBox x:Name="ChkArc" Click="Preview_Changed"/>
                                <CheckBox x:Name="ChkPanel" Click="Preview_Changed"/>
                                <CheckBox x:Name="ChkSeconds" Click="Preview_Changed"/>
                                <CheckBox x:Name="ChkSmooth" Click="Preview_Changed"/>
                                <CheckBox x:Name="Chk24" Click="Preview_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkTop"/>
                                <CheckBox x:Name="ChkTaskbar"/>
                                <CheckBox x:Name="ChkLock"/>
                                <CheckBox x:Name="ChkClickThru"/>
                                <CheckBox x:Name="ChkNotify"/>
                                <CheckBox x:Name="ChkSound"/>
                                <CheckBox x:Name="ChkStartup"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="LblAppearanceNote" Margin="0,10,0,0" Foreground="#FF555555" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ============ المعاينة ============ -->
        <Border Grid.Row="0" Grid.Column="1" Background="#FF2A2E34" CornerRadius="6" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ctl:ClockFace x:Name="Preview" Grid.Row="0" FlowDirection="LeftToRight"/>
                <TextBlock x:Name="LblPreview" Grid.Row="1" Foreground="#FFBBBBBB"
                           HorizontalAlignment="Center" Margin="0,4,0,2"/>
            </Grid>
        </Border>

        <!-- ============ الأزرار ============ -->
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="BtnOk"     Width="110" Height="30" Margin="0,0,8,0" DockPanel.Dock="Left" Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Width="110" Height="30" Margin="0,0,8,0" DockPanel.Dock="Left" Click="BtnCancel_Click" IsCancel="True"/>
            <Button x:Name="BtnReset"  Width="150" Height="30" DockPanel.Dock="Right" Click="BtnReset_Click"/>
        </DockPanel>
    </Grid>
</Window>
